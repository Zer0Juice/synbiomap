\section{Relatedness predicts entry}
% =================================================

\begin{frame}{Sub-fields are data-driven, not assumed}
\begin{columns}
\begin{column}{0.52\textwidth}
\begin{enumerate}
  \item SPECTER2 embeds each paper in 768-d space
  \item UMAP reduces to 50-d for clustering, 2-d for display
  \item HDBSCAN finds natural clusters (no $k$ required)
  \item Local LLM (Llama 3.2) labels each cluster from its most representative papers
\end{enumerate}
\vspace{0.6em}
Domain boundaries emerge from citation and semantic structure. The relatedness measure is built from the same embedding space: \highlight{no external classification is assumed}.
\end{column}
\begin{column}{0.45\textwidth}
\centering
\includegraphics[width=\textwidth]{figures/carbon_clusters_labeled.png}
\source{SPECTER2 + UMAP + HDBSCAN}
\end{column}
\end{columns}
\end{frame}

