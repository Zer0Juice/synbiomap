\section{A sharper hypothesis}
% =================================================

\begin{frame}{Reframing: iGEM participation as a treatment}
  \begin{block}{Working hypothesis}
    Participation in iGEM is correlated with a city's acceleration into new research domains related to its existing industrial mix.
  \end{block}

  \vspace{0.8em}
  \begin{columns}[T]
    \begin{column}{0.3\textwidth}
      \textbf{Dependent variable}\\
      City's entry rate into related new domains\\
      {\small (relatedness-weighted diversification)}
    \end{column}
    \begin{column}{0.3\textwidth}
      \textbf{Independent variable}\\
      iGEM participation\\
      {\small (team count, years active, subfield)}
    \end{column}
    \begin{column}{0.3\textwidth}
      \textbf{Controls}\\
      GDP per capita\\
      {\small + others TBD with Frank}
    \end{column}
  \end{columns}

  \vspace{0.8em}
  {\small Reading: Angrist \& Pischke, \textit{Mastering Metrics}; Cunningham, \textit{Causal Inference: The Mixtape}}
\end{frame}

