\section{Dual-space alignment}
% =================================================

\begin{frame}{Student projects and papers live in different text spaces}
  \begin{columns}[T]
    \begin{column}{0.46\textwidth}
      \textbf{iGEM project wikis}\\
      Informal, interdisciplinary, mixed register\\[0.5em]
      Embedded with \texttt{MiniLM-L6-v2}\\
      {\small General sentence encoder, 384 dimensions}
    \end{column}
    \begin{column}{0.46\textwidth}
      \textbf{Scientific papers}\\
      Formal abstracts, citation-supervised\\[0.5em]
      Embedded with \texttt{SPECTER2}\\
      {\small Trained on academic literature, 768 dimensions}
    \end{column}
  \end{columns}

  \vspace{1em}
  \textbf{The bridge: BioBrick parts}\\[0.3em]
  A BioBrick part cites papers in its documentation (Type A) and appears by name in published papers (Type B). This gives us \highlight{1,029 known project--paper pairs} across 520 iGEM teams.

  \vspace{0.5em}
  A linear map $W \in \mathbb{R}^{384 \times 768}$ fitted on these pairs projects student embeddings into the paper space.
\end{frame}

